# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: azure_openai | github_models | openai
LLM_PROVIDER=azure_openai

# Azure OpenAI (production) ───────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# GitHub Models (free dev/CI tier — same OpenAI-compatible API) ───────────────
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_TOKEN=github_pat_xxxx
GITHUB_CHAT_MODEL=gpt-4o

# OpenAI direct (fallback) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxx
OPENAI_CHAT_MODEL=gpt-4o

# ── External Data APIs ────────────────────────────────────────────────────────
# Alpha Vantage (market data + macro) — free tier: 25 calls/day
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# NewsAPI (financial news) — free tier: 100 calls/day
# https://newsapi.org/register
NEWSAPI_API_KEY=your-newsapi-key

# Finnhub (optional — additional financial data)
FINNHUB_API_KEY=your-finnhub-key

# ── LangSmith Tracing (optional but recommended) ──────────────────────────────
# https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=financial-research-agent

# ── Agent Behaviour ───────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
REACT_MAX_ITERATIONS=15
MAX_TOOL_RETRIES=3
# Illustrative fallback records are for local demos only. Set false outside development.
ALLOW_MOCK_DATA=true

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=8080
API_WORKERS=4
API_AUTH_REQUIRED=false
API_KEY=replace-with-a-long-random-local-secret
MAX_REQUEST_BODY_BYTES=65536
# Comma-separated browser origins; never use "*" in a shared environment.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
EXPOSE_API_DOCS=true

# ── Redis (optional result cache) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
CACHE_TTL_SECONDS=3600
